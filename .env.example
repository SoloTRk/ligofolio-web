# Supabase config
# Astro `import.meta.env.*` üzerinden okunur. `PUBLIC_*` prefix tarayıcıya
# bundle'lanır; prefix'siz olanlar SADECE server-side (SSR + API routes).

# Public (tarayıcıya gider — anon key, RLS-respecting)
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only (Vercel env vars, browser bundle'a SIZMAZ)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Edge Function URL'leri (varsayılan Supabase URL'den türetilir — opsiyonel
# override)
# EDGE_REQUEST_PREMIUM_OTP_URL=<supabase-url>/functions/v1/request-premium-otp
