---
interface Props {
  frontmatter?: {
    title?: string;
    description?: string;
  };
  title?: string;
  description?: string;
}

const { frontmatter, title: propTitle, description: propDescription } = Astro.props;

const title = frontmatter?.title ?? propTitle ?? 'ligofolio';
const description =
  frontmatter?.description ??
  propDescription ??
  'Emlakçılar için müşteri yönetimi (CRM), portföy paylaşımı ve akıllı eşleşme — tek mobil uygulamada.';

const SITE = (Astro.site ?? new URL('https://ligofolio.com')).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, SITE).toString();
const ogImage = new URL('/icon.png', SITE).toString();

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ligofolio',
  url: SITE,
  inLanguage: 'tr-TR',
  publisher: {
    '@type': 'Organization',
    name: 'AUTORIZEN IOT TEKNOLOJİLERİ VE MOBİLİTE HİZMETLERİ',
    url: SITE,
    logo: ogImage,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Samsun',
      addressCountry: 'TR',
    },
  },
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071A3D" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="any" href="/icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ligofolio" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="ligofolio — emlakçılar için CRM, portföy ve eşleşme" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">ligofolio</a>
      <nav class="site-nav">
        <a href="/privacy">Gizlilik</a>
        <a href="/terms">Koşullar</a>
        <a href="/support">Destek</a>
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-company">
        © 2026 AUTORIZEN IOT TEKNOLOJİLERİ VE MOBİLİTE HİZMETLERİ
      </p>
      <p class="footer-links">
        <a href="mailto:info@ligofolio.com">info@ligofolio.com</a>
        <span aria-hidden="true">·</span>
        <a href="/privacy">Gizlilik</a>
        <span aria-hidden="true">·</span>
        <a href="/terms">Koşullar</a>
      </p>
    </footer>

    <style is:global>
      :root {
        --brand-bg: #071a3d;
        --brand-fg: #ffffff;
        --brand-muted: #a8b3cc;
        --brand-accent: #f97316;
        --text-body: #1f2937;
        --text-heading: #0f172a;
        --bg-page: #ffffff;
        --bg-subtle: #f8fafc;
        --border: #e5e7eb;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          Arial,
          sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-body);
        background: var(--bg-page);
      }

      a {
        color: var(--brand-bg);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      a:hover {
        text-decoration-thickness: 2px;
      }

      h1,
      h2,
      h3,
      h4 {
        color: var(--text-heading);
        line-height: 1.25;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
      }
      h1 {
        font-size: 2rem;
      }
      h2 {
        font-size: 1.5rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.3rem;
      }
      h3 {
        font-size: 1.2rem;
      }

      p,
      ul,
      ol,
      table,
      blockquote {
        margin: 0.75rem 0;
      }

      blockquote {
        border-left: 3px solid var(--brand-accent);
        padding: 0.5rem 1rem;
        background: var(--bg-subtle);
        color: #475569;
        margin: 1rem 0;
      }

      code {
        background: var(--bg-subtle);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
        font-size: 0.9em;
      }

      table {
        border-collapse: collapse;
        width: 100%;
        margin: 1rem 0;
      }
      th,
      td {
        border: 1px solid var(--border);
        padding: 0.5rem 0.75rem;
        text-align: left;
      }
      th {
        background: var(--bg-subtle);
        font-weight: 600;
      }

      hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }

      /* ---------- Header ---------- */
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        background: var(--brand-bg);
        color: var(--brand-fg);
      }
      .brand {
        color: var(--brand-fg);
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .site-nav {
        display: flex;
        gap: 1.25rem;
      }
      .site-nav a {
        color: var(--brand-fg);
        text-decoration: none;
        opacity: 0.85;
      }
      .site-nav a:hover {
        opacity: 1;
        text-decoration: underline;
      }

      /* ---------- Main ---------- */
      .site-main {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
      }

      /* ---------- Footer ---------- */
      .site-footer {
        background: var(--bg-subtle);
        color: #64748b;
        padding: 2rem 1.5rem;
        text-align: center;
        font-size: 0.9rem;
        border-top: 1px solid var(--border);
      }
      .footer-company {
        margin: 0 0 0.5rem;
      }
      .footer-links {
        margin: 0;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .footer-links a {
        color: #64748b;
        text-decoration: none;
      }
      .footer-links a:hover {
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        .site-header {
          flex-direction: column;
          gap: 0.75rem;
          padding: 1rem;
        }
        .site-nav {
          gap: 1rem;
        }
        .site-main {
          padding: 1.5rem 1rem 3rem;
        }
        h1 {
          font-size: 1.6rem;
        }
        h2 {
          font-size: 1.25rem;
        }
      }
    </style>
  </body>
</html>
