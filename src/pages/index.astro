---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const TITLE = 'ligofolio — Emlakçılar için CRM, portföy paylaşımı ve eşleşme';
const DESCRIPTION =
  'Müşterilerini takip et, portföyünü meslektaşlarınla paylaş, talep-ilan eşleşmelerini cebinden kaçırma. Emlakçılığın günlük işini tek mobil uygulamada birleştir.';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'ligofolio',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'CRM',
  inLanguage: 'tr-TR',
  description: DESCRIPTION,
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Emlakçılar (gayrimenkul danışmanları)',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'TRY',
  },
  publisher: {
    '@type': 'Organization',
    name: 'AUTORIZEN IOT TEKNOLOJİLERİ VE MOBİLİTE HİZMETLERİ',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Samsun',
      addressCountry: 'TR',
    },
  },
};
---

<Layout title={TITLE} description={DESCRIPTION}>
  <section class="hero">
    <h1>
      Emlakçılığın <em>günlük işi</em>, cebinde.
    </h1>
    <p class="lede">
      Müşteri yönetimi, portföy paylaşımı ve akıllı eşleşme — tek mobil uygulamada.
      Excel, telefon defteri ve onlarca WhatsApp grubuna veda et.
    </p>

    <div class="cta-row">
      <span class="cta-placeholder" aria-label="App Store'da yakında">
        <strong>App Store</strong>
        <small>Yakında</small>
      </span>
      <span class="cta-placeholder" aria-label="Google Play'de yakında">
        <strong>Google Play</strong>
        <small>Yakında</small>
      </span>
    </div>
  </section>

  <section class="problems">
    <h2 class="section-title">Hangi sorunları çözüyoruz?</h2>
    <div class="card-grid">
      <div class="card">
        <h3>Dağınık müşteri kayıtları</h3>
        <p>
          Telefon defteri, Excel, ajanda, sticky not... Her bilgiyi farklı yerde aramak
          zaman kaybı, kayıp risk. ligofolio her müşteri için notlar, fotoğraflar, sesli
          kayıtlar ve hatırlatıcıları tek yerde toplar.
        </p>
      </div>
      <div class="card">
        <h3>Hangi meslektaşta hangi ilan var?</h3>
        <p>
          Müşterinin aradığı ev başka bir emlakçıda olabilir. Onlarca WhatsApp grubu
          ve manuel arama yerine, portföyleri ve talepleri görünür kıl; eşleşmeyi
          platform otomatik bulsun.
        </p>
      </div>
      <div class="card">
        <h3>Talep-ilan eşleşmesi için saatler</h3>
        <p>
          Yeni bir ilan eklenir eklenmez, kriterlerine uyan açık taleplerine otomatik
          eşlenir. Sen taramaya başlamadan önce sistem senin için tarar ve bildirim
          yollar.
        </p>
      </div>
    </div>
  </section>

  <section class="features">
    <h2 class="section-title">Tek uygulamada dört güçlü modül</h2>
    <div class="card-grid">
      <article class="card feature">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Kişisel Müşteri Yönetimi (CRM)</h3>
        <p>
          Cihaz rehberinden tek dokunuşla müşteri ekle. Her müşteriye notlar, sesli
          kayıt, fotoğraf, etiket ve hatırlatıcı bırak. Çevrimdışı çalışır, ağ
          gelince otomatik senkronize olur.
        </p>
      </article>

      <article class="card feature">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h3>Portföy Yönetimi</h3>
        <p>
          İlanlarını yayınla — özel, organizasyon içi veya tüm platforma açık görünürlük
          seçenekleriyle kontrol elinde. Fotoğraf, fiyat, konum, mülk tipi ve teknik
          özelliklerle eksiksiz ilan.
        </p>
      </article>

      <article class="card feature">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3>Akıllı Eşleşme</h3>
        <p>
          İl, ilçe, mahalle, fiyat aralığı, mülk tipi ve oda sayısı kriterleriyle
          müşteri talebini ilanlarla otomatik eşler. Yeni eşleşme olduğu an anlık
          bildirim alırsın.
        </p>
      </article>

      <article class="card feature">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><circle cx="19" cy="11" r="2"/><circle cx="5" cy="11" r="2"/></svg>
        </div>
        <h3>Meslektaş Ağı</h3>
        <p>
          Diğer emlakçılarla bağlantı kur, kendi ajansını oluştur veya bir organizasyona
          katıl. Profilini QR kod veya link ile paylaş; itibarın seninle gezsin.
        </p>
      </article>
    </div>
  </section>

  <section class="trust">
    <h2 class="section-title">Verin güvende</h2>
    <ul class="trust-list">
      <li>
        <strong>KVKK + GDPR uyumlu.</strong> Türkiye'de ve Avrupa Birliği'nde yürürlükteki
        kişisel veri koruma mevzuatına tam uyumlu olarak tasarlandı.
      </li>
      <li>
        <strong>Müşteri rehberin sana özel.</strong> CRM verisi yalnız sana görünür;
        diğer kullanıcılarla paylaşılmaz, satılmaz, kiralanmaz.
      </li>
      <li>
        <strong>Açık veri seçenekleri.</strong> Profilinde telefon ve e-postanın görünür
        olup olmayacağına sen karar verirsin.
      </li>
      <li>
        <strong>İstediğin zaman silebilirsin.</strong> 30 günlük geri alma süresiyle
        hesap silme; KVKK haklarının tamamı uygulama içinden kullanılabilir.
      </li>
    </ul>
    <p class="trust-cta">
      Tüm detaylar için <a href="/privacy">Gizlilik Politikası</a> ve
      <a href="/terms">Kullanım Şartları</a> sayfalarımıza bakabilirsin.
    </p>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(appSchema)}
    is:inline
  />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    text-align: center;
    padding: 3.5rem 0 2.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    color: #071a3d;
    line-height: 1.15;
    border: none;
    padding: 0;
  }
  .hero h1 em {
    font-style: normal;
    color: #f97316;
  }
  .lede {
    font-size: 1.15rem;
    color: #334155;
    max-width: 580px;
    margin: 0 auto 2rem;
    line-height: 1.55;
  }

  /* ---------- CTA Placeholders ---------- */
  .cta-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-placeholder {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 0.65rem 1.25rem;
    border: 1px dashed #cbd5e1;
    border-radius: 10px;
    color: #64748b;
    min-width: 160px;
    line-height: 1.2;
  }
  .cta-placeholder strong {
    color: #334155;
    font-size: 0.95rem;
  }
  .cta-placeholder small {
    font-size: 0.78rem;
    margin-top: 2px;
    color: #94a3b8;
  }

  /* ---------- Sections ---------- */
  .section-title {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 0.4rem;
    color: #0f172a;
  }

  /* ---------- Cards ---------- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .card {
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #ffffff;
  }
  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: #071a3d;
  }
  .card p {
    margin: 0;
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .feature-icon {
    color: #071a3d;
    margin-bottom: 0.6rem;
    display: inline-flex;
  }

  /* ---------- Trust ---------- */
  .trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .trust-list li {
    padding: 0.85rem 1rem;
    background: #f8fafc;
    border-left: 3px solid #071a3d;
    border-radius: 4px;
    color: #334155;
    line-height: 1.5;
  }
  .trust-list strong {
    color: #0f172a;
  }
  .trust-cta {
    margin-top: 1rem;
    color: #64748b;
    font-size: 0.95rem;
  }
</style>
